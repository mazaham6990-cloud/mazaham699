{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mazaham699",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "96200e5d-bfc0-4c02-98a6-c1d881c29619","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "410509f447bd462b883f8cfe7aef7066" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
